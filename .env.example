# Environment variables for local development
PORT=8080
POSTGRES_URL=postgres://banking_user:banking_password@localhost:5432/banking_db?sslmode=disable
MONGODB_URL=mongodb://mongo_user:mongo_password@localhost:27017/banking_logs?authSource=admin
RABBITMQ_URL=amqp://rabbit_user:rabbit_password@localhost:5672/

# Logging
LOG_LEVEL=info

# Queue configuration
TRANSACTION_QUEUE=transactions
RETRY_QUEUE=transaction_retries
MAX_RETRY_ATTEMPTS=3

# Database configuration
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m